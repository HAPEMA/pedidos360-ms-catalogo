# Copiar a /etc/pedidos360/ms-catalogo.env y reemplazar los valores de ejemplo.
# chmod 600 /etc/pedidos360/ms-catalogo.env  (contiene secretos)

# Puerto HTTP del servicio
PORT=8081

# PostgreSQL en RDS
DB_URL=jdbc:postgresql://mi-instancia.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/catalogo
DB_USER=catalogo_app
DB_PASS=cambiar-por-la-clave-real

# API Ninjas (https://api-ninjas.com)
NINJA_API_KEY=cambiar-por-la-api-key-real
NINJA_BASE_URL=https://api.api-ninjas.com/v1

# Amazon Cognito (us-east-1)
COGNITO_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Origen exacto del front (CORS), sin barra final
FRONT_ORIGIN=https://mi-front.example.com
