# Copiar a /etc/pedidos360/ms-catalogo.env y reemplazar cada REEMPLAZAR_EN_EC2 por el valor real.
# sudo chmod 600 /etc/pedidos360/ms-catalogo.env  (el archivo real contiene secretos)

# Puerto HTTP del servicio
PORT=8081

# PostgreSQL en RDS
DB_URL=jdbc:postgresql://<RDS_HOST>:5432/catalogo_db
DB_USER=postgres
DB_PASS=REEMPLAZAR_EN_EC2

# API Ninjas (https://api-ninjas.com)
NINJA_API_KEY=REEMPLAZAR_EN_EC2
NINJA_BASE_URL=https://api.api-ninjas.com/v1

# Amazon Cognito (us-east-1)
COGNITO_POOL_ID=<USER_POOL_ID>
COGNITO_CLIENT_ID=<APP_CLIENT_ID>

# Origen exacto del front (CORS), sin barra final.
# Cambiar por la URL de CloudFront cuando exista.
FRONT_ORIGIN=http://localhost:4200

# URL del issuer del User Pool (sin barra final). Reemplaza a COGNITO_POOL_ID cuando se define.
# COGNITO_ISSUER_URI=https://cognito-idp.<region>.amazonaws.com/<userPoolId>
